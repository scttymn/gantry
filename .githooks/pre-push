#!/usr/bin/env bash
# Before a push, the ci workflow's checks on this machine (bin/ci): a push
# that would fail CI doesn't leave it. A push to main, or with
# GANTRY_CI_FULL=1, runs every check; another, those its changes since the
# remote branch (or origin/main) need (bin/ci --changed).
# Once per clone:
#   git config core.hooksPath .githooks
# bin/ci checks the checkout, so the commit pushed must be HEAD, with nothing
# in the tree that isn't in it (TestPrePushHook).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

head=$(git rev-parse HEAD)
pushes=
base=
main=
while read -r _ local_sha remote_ref remote_sha; do
	case $local_sha in *[!0]*) ;; *) continue ;; esac # deleting a ref
	pushes=1
	[ "$remote_ref" != refs/heads/main ] || main=1
	if [ "$(git rev-parse "$local_sha^{commit}")" != "$head" ]; then
		echo "pre-push: bin/ci checks the checkout, and $local_sha isn't HEAD: check it out, then push" >&2
		exit 1
	fi
	case $remote_sha in
		*[!0]*) [ -n "$base" ] || base=$remote_sha ;;
	esac
done
[ -n "$pushes" ] || exit 0
if [ -n "$(git status --porcelain)" ]; then
	echo "pre-push: the tree has changes that aren't in the commit, and bin/ci would check them too: commit, stash or remove them, then push" >&2
	git status --short >&2
	exit 1
fi

if [ -n "$main" ] || [ "${GANTRY_CI_FULL:-}" = 1 ]; then
	exec bin/ci </dev/null
fi
# Only from a remote commit HEAD is built on: from one HEAD is behind (a
# branch reset and force-pushed), the diff since their merge base is empty.
if [ -n "$base" ] && git merge-base --is-ancestor "$base" HEAD 2>/dev/null; then
	exec bin/ci --changed "$base" </dev/null
fi
if git rev-parse --verify -q origin/main >/dev/null 2>&1 && [ "$(git rev-parse origin/main)" != "$head" ]; then
	exec bin/ci --changed origin/main </dev/null
fi
if git rev-parse --verify -q main >/dev/null 2>&1 && [ "$(git rev-parse main)" != "$head" ]; then
	exec bin/ci --changed main </dev/null
fi
exec bin/ci </dev/null
