#!/usr/bin/env bash
# Before a push, the ci workflow's checks on this machine (bin/ci): a push
# that would fail CI doesn't leave it. Once per clone:
#   git config core.hooksPath .githooks
# bin/ci checks the working tree, which is what's pushed when it's clean and
# at the pushed commit.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

pushes=
while read -r _ local_sha _ _; do
	case $local_sha in *[!0]*) pushes=1 ;; esac
done
[ -n "$pushes" ] || exit 0 # deleting branches or tags only

exec bin/ci </dev/null
