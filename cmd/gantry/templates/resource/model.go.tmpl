package models
{{- range .Columns}}{{if and .Required (or (eq .Type "string") (eq .Type "text"))}}

import "strings"
{{- break}}{{end}}{{end}}

// Errors are the Rails model's validations, as its full messages.
func ({{recv}} {{.Model}}) Errors() []string {
	var errs []string
{{- range .Columns}}{{if .Required}}
{{- if or (eq .Type "string") (eq .Type "text")}}
	if strings.TrimSpace({{recv}}.{{.Go}}) == "" {
		errs = append(errs, "{{.Label}} can't be blank")
	}
{{- else}}
	if !{{recv}}.{{.Go}}.Valid {
		errs = append(errs, "{{.Label}} can't be blank")
	}
{{- end}}{{end}}{{end}}
	return errs
}
