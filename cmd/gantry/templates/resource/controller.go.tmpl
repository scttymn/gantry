package {{.Package}}

import (
	"maps"
	"net/http"
	"strconv"
	"strings"

	"github.com/a-h/templ"

	"github.com/scttymn/gantry/db"
	"github.com/scttymn/gantry/web"

	"{{.Module}}/app/models"
	"{{.Module}}/app/shared/resource"
)

const (
	path     = "{{.Base}}"
	param    = "{{.Param}}"
	title    = "{{.Title}}"
	singular = "{{.Singular}}"
{{- if .Photos}}
	recordType = "{{.Model}}"
{{- end}}
)

type Controller struct{ resource.Controller }

var fields = []resource.Field{ {{- range $i, $f := .Fields}}{{if $i}}, {{end}}{{field $f}}{{end -}} }

var editFields = append(fields, resource.F("lock_version", resource.Type("hidden")))

func formValues({{var}} models.{{.Model}}) map[string]string {
	return map[string]string{ {{- range .Columns}}"{{.Column}}": {{toText .}}, {{end}}"lock_version": strconv.FormatInt({{if .Postgres}}int64({{var}}.LockVersion){{else}}{{var}}.LockVersion{{end}}, 10)}
}

func fromForm(v map[string]string) models.{{.Model}} {
	return models.{{.Model}}{ {{- range $i, $f := .Columns}}{{if $i}}, {{end}}{{$f.Go}}: {{fromText $f}}{{end -}} }
}

func (c Controller) Index(w http.ResponseWriter, r *http.Request) error {
	list, err := models.New(c.DB.Read).List{{.Plural}}(r.Context())
	if err != nil {
		return err
	}
	rows := make([]resource.Row, len(list))
	for i, {{var}} := range list {
		rows[i] = resource.Row{ID: {{var}}.ID, Cells: []string{ {{- range $i, $f := .List}}{{if $i}}, {{end}}{{cell $f}}{{end -}} }}
	}
	return c.Render(w, r, http.StatusOK, title, func(p resource.Page) templ.Component { return index(p, rows) })
}

func (c Controller) New(w http.ResponseWriter, r *http.Request) error {
	return c.form(w, r, http.StatusOK, 0, map[string]string{}, nil)
}

func (c Controller) Create(w http.ResponseWriter, r *http.Request) error {
	v := resource.Overlay(r, param, map[string]string{})
	{{var}} := fromForm(v)
	if errs := {{var}}.Errors(); len(errs) > 0 {
		return c.form(w, r, http.StatusUnprocessableEntity, 0, v, errs)
	}
	{{if .Photos}}var id int64
	{{end}}err := c.DB.Tx(r.Context(), func(tx *db.Tx) (err error) {
		q := models.New(tx)
{{- if .Position}}
		if !{{var}}.Position.Valid {
			next, err := q.Next{{.Model}}Position(r.Context())
			if err != nil {
				return err
			}
			{{var}}.Position.Int64, {{var}}.Position.Valid = next, true
		}
{{- end}}
		{{if .Photos}}id{{else}}_{{end}}, err = q.Create{{.Model}}(r.Context(), models.Create{{.Model}}Params{ {{- range .Columns}}{{.Go}}: {{param .}}, {{end}}Now: c.Now()})
		return err
	})
	if err != nil {
		return err
	}
{{- range .Photos}}
	if err := c.SavePhoto(r, param, "{{.Column}}", recordType, id); err != nil {
		return err
	}
{{- end}}
	return c.Created(w, r, path, singular)
}

func (c Controller) Edit(w http.ResponseWriter, r *http.Request) error {
	{{var}}, err := models.New(c.DB.Read).Get{{.Model}}(r.Context(), web.ID(r, "id"))
	if err != nil {
		return err
	}
	return c.form(w, r, http.StatusOK, {{var}}.ID, formValues({{var}}), nil)
}

func (c Controller) Update(w http.ResponseWriter, r *http.Request) error {
	sent := resource.Overlay(r, param, map[string]string{})
	var (
		id     int64
		v      map[string]string
		status int
		errs   []string
	)
	err := c.DB.Tx(r.Context(), func(tx *db.Tx) error {
		q := models.New(tx)
		was, err := q.Get{{.Model}}ForUpdate(r.Context(), web.ID(r, "id"))
		if err != nil {
			return err
		}
		id, v = was.ID, formValues(was)
		version := v["lock_version"]
		maps.Copy(v, sent)
		v["lock_version"] = version
		if sent["lock_version"] != version {
			status, errs = http.StatusConflict, []string{"Someone else changed this record while you were editing. Your values are still in the form; submitting again will save them."}
			return nil
		}
		{{var}} := fromForm(v)
		if errs = {{var}}.Errors(); len(errs) > 0 {
			status = http.StatusUnprocessableEntity
			return nil
		}
		return q.Update{{.Model}}(r.Context(), models.Update{{.Model}}Params{ {{- range .Columns}}{{.Go}}: {{param .}}, {{end}}Now: c.Now(), ID: id})
	})
	if err != nil {
		return err
	}
	if len(errs) > 0 {
		return c.form(w, r, status, id, v, errs)
	}
{{- range .Photos}}
	if err := c.SavePhoto(r, param, "{{.Column}}", recordType, id); err != nil {
		return err
	}
{{- end}}
	return c.Saved(w, r, path, singular)
}

func (c Controller) Delete(w http.ResponseWriter, r *http.Request) error {
	q := models.New(c.DB.Write)
	{{var}}, err := q.Get{{.Model}}(r.Context(), web.ID(r, "id"))
	if err != nil {
		return err
	}
{{- range .Photos}}
	if err := c.PurgePhoto(r.Context(), recordType, {{var}}.ID, "{{.Column}}"); err != nil {
		return err
	}
{{- end}}
	if err := q.Delete{{.Model}}(r.Context(), {{var}}.ID); err != nil {
		return err
	}
	return c.Deleted(w, r, path, singular)
}

func (c Controller) form(w http.ResponseWriter, r *http.Request, status int, id int64, v map[string]string, errs []string) error {
	f := resource.Form{Param: param, Values: v, Errors: errs, Fields: fields, Cancel: path, Action: path, Method: "post"}
	heading := "New " + strings.ToLower(singular)
	if id != 0 {
		f.Action, f.Method, f.Fields, heading = path+"/"+web.IDText(id), "patch", editFields, "Edit "+strings.ToLower(singular)
{{- if .Photos}}
		photos, err := c.PhotoPreviews(r.Context(), recordType, id{{range .Photos}}, "{{.Column}}"{{end}})
		if err != nil {
			return err
		}
		f.Photos = photos
{{- end}}
	}
	return c.Render(w, r, status, heading, func(p resource.Page) templ.Component { return form(p, f) })
}
