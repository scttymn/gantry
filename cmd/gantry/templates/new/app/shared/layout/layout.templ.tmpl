// Package layout is the page shell every page is drawn in.
package layout

import "{{.Module}}/assets"

// Page is what the layout needs from a page.
type Page struct {
	Title string
}

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>{ p.Title }</title>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			@assets.Styles.Tag()
			@assets.ImportMap.Tag()
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
