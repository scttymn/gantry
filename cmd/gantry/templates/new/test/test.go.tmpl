// Package test is what the app's tests share: a database of their own,
// migrated. Fixtures go in test/fixtures/<table>.yml (testkit.Fixtures).
package test

import (
	"testing"

	"github.com/scttymn/gantry/db"
	"github.com/scttymn/gantry/testkit"

	"{{.Module}}/db/migrations"
)

// DB is an empty, migrated database, removed after the test{{if .Postgres}}: a
// database of its own on the Postgres server at TEST_DATABASE_URL{{end}}.
func DB(t testing.TB) *db.DB { return testkit.{{if .Postgres}}Postgres{{else}}DB{{end}}(t, migrations.Up) }
