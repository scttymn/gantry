func main() {
	if images.IsChild(os.Args) {
		os.Exit(app.Pictures.RunChild(os.Args))
	}
	if exe, err := os.Executable(); err == nil {
		app.Pictures.Maker = images.Child{Exe: exe}
	}
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	logger := slog.New(slog.NewTextHandler(os.Stdout, nil))
	os.Exit(command(ctx, config.FromEnv(), logger, os.Args[1:], os.Stdin, os.Stdout, os.Stderr))
}

const usage = `usage:
  {{.Name}}                        serve (the default), and run the jobs unless JOBS_IN_SERVER=false
  {{.Name}} jobs                   run the background jobs alone
  {{.Name}} assets [DIR]           the assets precompiled, into DIR (assets/built; the build runs it)
  {{.Name}} db migrate|rollback [N]|status|seed|reset|console
  {{.Name}} tasks                  the app's own tasks (app/tasks.go)
  {{.Name}} task NAME [ARGS...]    run one
  {{.Name}} routes [--json]        the app's routes (app/routes.go), or as JSON
`

func command(ctx context.Context, cfg config.Config, logger *slog.Logger, args []string, in io.Reader, out, errOut io.Writer) int {
	name := "serve"
	if len(args) > 0 {
		name, args = args[0], args[1:]
	}
	var err error
	switch name {
	case "serve":
		err = serve(ctx, cfg, logger, nil)
	case "jobs":
		err = runJobs(ctx, cfg, logger)
	case "assets":
		dir := filepath.Join("assets", "built")
		if len(args) > 0 {
			dir = args[0]
		}
		if why := images.AVIFSlow(); why != "" {
			fmt.Fprintf(errOut, "assets: no AVIF copies, as %s: the encoder would take minutes a copy here; the pictures are WebP alone\n", why)
		}
		var made int
		made, err = assets.All.Precompile(ctx, dir)
		if err == nil {
			fmt.Fprintf(out, "assets: precompiled into %s (%d picture copies made)\n", dir, made)
		}
	case "db":
		return dbCommand(ctx, cfg, args, in, out, errOut)
	case "tasks":
		for _, t := range app.Tasks {
			fmt.Fprintf(out, "%-20s %s\n", t.Name, t.Help)
		}
		return 0
	case "task":
		err = task(ctx, cfg, logger, args, out)
	case "routes":
		err = routes(ctx, cfg, slog.New(slog.NewTextHandler(errOut, nil)), args, out)
	default:
		fmt.Fprint(errOut, usage)
		return 2
	}
	if err != nil {
		fmt.Fprintln(errOut, "{{.Name}}:", err)
		return 1
	}
	return 0
}

func build(ctx context.Context, cfg config.Config, logger *slog.Logger) (a *app.App, close func(), err error) {
	proxies, err := web.ParseProxies(cfg.TrustedProxies)
	if err != nil {
		return nil, nil, fmt.Errorf("TRUSTED_PROXIES: %w", err)
	}
	database, err := db.Open(ctx, cfg.DatabaseURL)
	if err != nil {
		return nil, nil, err
	}
	defer func() {
		if err != nil {
			database.Close()
		}
	}()
	if err := migrations.Up(ctx, database); err != nil {
		return nil, nil, err
	}
	if err := seeds.Run(ctx, database); err != nil {
		return nil, nil, err
	}
	key, err := sign.Key(ctx, database, cfg.SecretKey)
	if err != nil {
		return nil, nil, err
	}
	queue, err := jobs.New(ctx, database, jobs.Options{Log: logger})
	if err != nil {
		return nil, nil, err
	}
	mailer, err := mail.Open(ctx, cfg.Env, cfg.DataDir, cfg.Mail, logger)
	if err != nil {
		return nil, nil, err
	}
	defer func() {
		if err != nil {
			mailer.Close()
		}
	}()
	layout.Site.URL = cfg.SiteURL
	signer := sign.Signer{Key: key}
	a = &app.App{Mail: mailer, DB: database, Log: logger, Signer: signer, Jobs: queue, Live: live.New(signer, live.Options{Log: logger}),
		Proxies: web.Proxies{Trusted: proxies}, Production: cfg.Env == "production"}
	if err := a.DefineJobs(); err != nil {
		return nil, nil, err
	}
	return a, func() {
		mailer.Close()
		database.Close()
	}, nil
}

func serve(ctx context.Context, cfg config.Config, logger *slog.Logger, listening chan<- string) error {
	a, closeDB, err := build(ctx, cfg, logger)
	if err != nil {
		return err
	}
	defer closeDB()
	server := &http.Server{Handler: a.Handler(), ReadHeaderTimeout: 10 * time.Second,
		ReadTimeout: 30 * time.Second, WriteTimeout: 60 * time.Second, IdleTimeout: 2 * time.Minute}
	server.RegisterOnShutdown(a.Live.Close)

	ln, err := net.Listen("tcp", cfg.Addr)
	if err != nil {
		return err
	}
	logger.Info("listening", "addr", ln.Addr().String(), "env", cfg.Env)
	if listening != nil {
		listening <- ln.Addr().String()
	}
	jobsCtx, stopJobs := context.WithCancel(ctx)
	jobsDone := make(chan error, 1)
	if cfg.JobsInServer {
		go func() { jobsDone <- a.Jobs.Run(jobsCtx) }()
	} else {
		jobsDone <- nil
	}
	defer func() { stopJobs(); <-jobsDone }()
	errs := make(chan error, 1)
	go func() { errs <- server.Serve(ln) }()
	select {
	case err := <-errs:
		return err
	case <-ctx.Done():
	}
	shutdown, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	if err := server.Shutdown(shutdown); err != nil && !errors.Is(err, http.ErrServerClosed) {
		return err
	}
	return nil
}

func runJobs(ctx context.Context, cfg config.Config, logger *slog.Logger) error {
	a, closeDB, err := build(ctx, cfg, logger)
	if err != nil {
		return err
	}
	defer closeDB()
	logger.Info("running jobs", "env", cfg.Env)
	return a.Jobs.Run(ctx)
}

func routes(ctx context.Context, cfg config.Config, logger *slog.Logger, args []string, out io.Writer) error {
	if len(args) > 1 || len(args) == 1 && args[0] != "--json" {
		return errors.New("usage: {{.Name}} routes [--json]")
	}
	a, closeDB, err := build(ctx, cfg, logger)
	if err != nil {
		return err
	}
	defer closeDB()
	list := a.Router().Routes()
	if len(args) == 1 {
		return json.NewEncoder(out).Encode(list)
	}
	for _, r := range list {
		fmt.Fprintln(out, r)
	}
	return nil
}

func task(ctx context.Context, cfg config.Config, logger *slog.Logger, args []string, out io.Writer) error {
	if len(args) == 0 {
		return errors.New("which task? `{{.Name}} tasks` lists them")
	}
	for _, t := range app.Tasks {
		if t.Name != args[0] {
			continue
		}
		database, err := db.Open(ctx, cfg.DatabaseURL)
		if err != nil {
			return err
		}
		defer database.Close()
		if err := migrations.Up(ctx, database); err != nil {
			return err
		}
		return t.Run(ctx, app.TaskEnv{DB: database, Log: logger, Out: out}, args[1:])
	}
	return fmt.Errorf("no task %q: `{{.Name}} tasks` lists them", args[0])
}
