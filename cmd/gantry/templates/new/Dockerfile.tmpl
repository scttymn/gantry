# Stages: toolchain (Go, templ, sqlc, {{if .Postgres}}psql and pg_dump{{else}}sqlite3{{end}}), dev (the mounted code,
# rebuilt on change), test, and production (a static binary on an empty
# image). Houston builds dev for gantry dev, test for gantry test, and
# production to deploy.

FROM golang:1.27-bookworm AS toolchain
COPY --from=sqlc/sqlc:1.31.1 /workspace/sqlc /usr/local/bin/sqlc
{{- if .Postgres}}
# Postgres 17's client (psql for db console, pg_dump for db/schema.sql),
# from PostgreSQL's own apt repository: Debian's is older than the server.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-common \
 && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
 && apt-get install -y --no-install-recommends postgresql-client-17 \
 && rm -rf /var/lib/apt/lists/*
{{- else}}
# sqlite3, for db console.
RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 && rm -rf /var/lib/apt/lists/*
{{- end}}
# nodynamic: gantry's image codecs run as WASM, so the binary stays static.
ENV CGO_ENABLED=0 GOFLAGS="-buildvcs=false -tags=nodynamic"
RUN go install github.com/a-h/templ/cmd/templ@{{.Templ}}
WORKDIR /app

# templ regenerates on change and restarts the server. Caches live in the
# mounted folder's .cache/ (ignored, and skipped by the watcher), so
# restarts reuse them.
FROM toolchain AS dev
{{- if .InModule}}
# The app is {{.Dir}}/ in its module, which is mounted at /app.
WORKDIR {{.Work}}
{{- end}}
ENV GANTRY_ENV=development ADDR=:8080 DATA_DIR=/data GOMODCACHE={{.Work}}/.cache/go/mod GOCACHE={{.Work}}/.cache/go/cache
CMD ["templ", "generate", "--watch", "-path", "{{.Work}}", "--watch-pattern=(.+\\.go$)|(.+\\.templ$)|(.+\\.js$)|(.+\\.css$)|(.+\\.sql$)", "--cmd=go run ./cmd/{{.Name}}"]

FROM toolchain AS test
ENV GANTRY_ENV=test
COPY go.mod go.sum ./
RUN go mod download
COPY . .
{{- if .InModule}}
WORKDIR {{.Work}}
{{- end}}
RUN templ generate -path {{.Work}}
# The assets precompiled as the build does them, so the tests see what
# production serves and no picture is resized on request.
RUN --mount=type=cache,id={{.Name}}-assets,target=/cache/assets,sharing=locked \
    go run ./cmd/{{.Name}} assets /cache/assets && cp -a /cache/assets/. assets/built/
CMD ["sh", "-c", "go vet ./... && go test ./..."]

FROM toolchain AS build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
{{- if .InModule}}
WORKDIR {{.Work}}
{{- end}}
# The assets precompiled first (Rails' assets:precompile: the scripts
# minified, the pictures' copies), for go build to embed. They're kept in a
# build cache between deploys, so only a new or changed picture is resized.
RUN --mount=type=cache,id={{.Name}}-assets,target=/cache/assets,sharing=locked \
    templ generate -path {{.Work}} && go run ./cmd/{{.Name}} assets /cache/assets && cp -a /cache/assets/. assets/built/ \
 && go build -trimpath -ldflags "-s -w" -tags timetzdata,nodynamic -o /out/app ./cmd/{{.Name}}
RUN mkdir -p /out/data

FROM scratch AS production
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /out/app /app
COPY --from=build --chown=65532:65532 /out/data /data
USER 65532:65532
ENV ADDR=:8080 DATA_DIR=/data
EXPOSE 8080
ENTRYPOINT ["/app"]
