# Stages: toolchain (Go, templ, sqlc, {{if .Postgres}}psql and pg_dump{{else}}sqlite3{{end}}), dev (the mounted code,
# rebuilt on change), test, and production (a static binary without the
# development checks, on an empty image). Houston builds dev for gantry dev,
# test for gantry test, and production to deploy.

FROM {{.GolangImage}} AS toolchain
COPY --from={{.SqlcImage}} /workspace/sqlc /usr/local/bin/sqlc
{{- if .Postgres}}
# Postgres 17's client (psql for db console, pg_dump for db/schema.sql),
# from PostgreSQL's own apt repository: Debian's is older than the server.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-common \
 && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
 && apt-get install -y --no-install-recommends postgresql-client-17 \
 && rm -rf /var/lib/apt/lists/*
{{- else}}
# sqlite3, for db console.
RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 && rm -rf /var/lib/apt/lists/*
{{- end}}
# cgo: gantry's db has SQLite compiled from C (the production build links
# it statically, so the binary still runs on an empty image). The sqlite_
# tags and CGO_CFLAGS are what that C is compiled with: full-text search,
# math functions and the rest SQLite translated to Go has, so an app's SQL
# means the same either way (gantry's db won't start without them).
# nodynamic: gantry's image codecs run as WASM. netgo, osusergo and
# timetzdata: Go's own name lookups and time zones, not the C library's, as
# a static binary on an empty image needs.
ENV CGO_ENABLED=1 CGO_CFLAGS="{{.SQLiteCFlags}}" \
    GOFLAGS="-buildvcs=false -tags={{.SQLiteTags}}"
RUN go install github.com/a-h/templ/cmd/templ@{{.Templ}}
WORKDIR /app

# templ regenerates on change and restarts the server. Caches live in the
# mounted folder's .cache/ (ignored, and skipped by the watcher), so
# restarts reuse them.
FROM toolchain AS dev
{{- if .InModule}}
# The app is {{.Dir}}/ in its module, which is mounted at /app.
WORKDIR {{.Work}}
{{- else if .GantryMount}}
# The app is mounted at {{.DevWork}}, and the gantry checkout at {{.GantryMount}}.
WORKDIR {{.DevWork}}
{{- end}}
ENV GANTRY_ENV=development ADDR=:8080 DATA_DIR=/data GOMODCACHE={{.DevWork}}/.cache/go/mod GOCACHE={{.DevWork}}/.cache/go/cache
CMD ["templ", "generate", "--watch", "-path", "{{.DevWork}}", "--watch-pattern=(.+\\.go$)|(.+\\.templ$)|(.+\\.js$)|(.+\\.css$)|(.+\\.sql$)", "--cmd=go run ./cmd/{{.Name}}"]

FROM toolchain AS test
ENV GANTRY_ENV=test
COPY go.mod go.sum ./
RUN go mod download
COPY . .
{{- if .InModule}}
WORKDIR {{.Work}}
{{- end}}
RUN templ generate -path {{.Work}}
# The assets precompiled as the build does them, so the tests see what
# production serves and no picture is resized on request.
RUN --mount=type=cache,id={{.Name}}-assets,target=/cache/assets,sharing=locked \
    go run ./cmd/{{.Name}} assets /cache/assets && cp -a /cache/assets/. assets/built/
# The build as production compiles it too (nodevcheck, below), so code that
# only the dev stage has, such as web.DevelopmentWithRules, fails here and
# not at deploy.
CMD ["sh", "-c", "go vet ./... && GOFLAGS=\"$GOFLAGS,nodevcheck\" go build ./... && go test ./..."]

FROM toolchain AS build
# nodevcheck: the production binary leaves out the development checks
# (web.Development's source scanner); dev keeps them. It extends -tags, so
# -tags must stay the last flag in the toolchain's GOFLAGS.
ENV GOFLAGS="${GOFLAGS},nodevcheck"
COPY go.mod go.sum ./
RUN go mod download
COPY . .
{{- if .InModule}}
WORKDIR {{.Work}}
{{- end}}
# The assets precompiled first (Rails' assets:precompile: the scripts
# minified, the pictures' copies), for go build to embed. They're kept in a
# build cache between deploys, so only a new or changed picture is resized;
# and so is Go's, so SQLite's C is compiled once, not on every deploy. The
# binary is linked statically, for the empty image it runs on.
RUN --mount=type=cache,id={{.Name}}-assets,target=/cache/assets,sharing=locked \
    --mount=type=cache,id={{.Name}}-go,target=/root/.cache/go-build \
    templ generate -path {{.Work}} && go run ./cmd/{{.Name}} assets /cache/assets && cp -a /cache/assets/. assets/built/ \
 && go build -trimpath -ldflags "-s -w -linkmode external -extldflags -static" -o /out/app ./cmd/{{.Name}}
RUN mkdir -p /out/data

FROM scratch AS production
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /out/app /app
COPY --from=build --chown=65532:65532 /out/data /data
USER 65532:65532
ENV ADDR=:8080 DATA_DIR=/data
EXPOSE 8080
ENTRYPOINT ["/app"]
