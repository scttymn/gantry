package migrations_test

import (
	"context"
	"os"
	"testing"

	"github.com/scttymn/gantry/testkit"

	"{{.Module}}/db/migrations"
	"{{.Module}}/test"
)

func TestMigrations(t *testing.T) {
	testkit.Migrations(t, testkit.{{if .Postgres}}Postgres{{else}}DB{{end}}(t, nil), migrations.Files, migrations.Table)
}

func TestSchemaIsCurrent(t *testing.T) {
	d := test.DB(t)
	got, err := d.Schema(context.Background(), migrations.Table)
	if err != nil {
		t.Fatal(err)
	}
	want, _ := os.ReadFile("../schema.sql")
	if string(want) != got {
		t.Fatal("db/schema.sql isn't what the migrations make: run gantry db migrate")
	}
}
