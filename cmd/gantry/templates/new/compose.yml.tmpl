name: {{.Name}}

services:
  app:
{{- if .InModule}}
    build: { context: {{.Up}}, dockerfile: {{.Dir}}/Dockerfile, target: dev }
{{- else}}
    build: { context: ., target: dev }
{{- end}}
    expose: ["8080"]
    environment:
      GANTRY_DEV_WARNINGS: ${GANTRY_DEV_WARNINGS:-true}
      GANTRY_DEV_RELOAD: ${GANTRY_DEV_RELOAD:-true}
      MAIL_DRIVER: ${MAIL_DRIVER:-}
      MAIL_FROM: ${MAIL_FROM:-}
      SMTP_HOST: ${SMTP_HOST:-}
      SMTP_PORT: ${SMTP_PORT:-587}
      SMTP_USERNAME: ${SMTP_USERNAME:-}
      SMTP_PASSWORD: ${SMTP_PASSWORD:-}
      SMTP_TLS: ${SMTP_TLS:-}
      SECRET_KEY: ${SECRET_KEY:-}
      SITE_URL: ${SITE_URL:-}
      TRUSTED_PROXIES: ${TRUSTED_PROXIES:-}
{{- if .Postgres}}
      DATABASE_URL: postgres://postgres:${POSTGRES_PASSWORD}@${DB_HOST:-db}:5432/{{.Name}}?sslmode=disable
      TEST_DATABASE_URL: postgres://postgres:${POSTGRES_PASSWORD}@${DB_HOST:-db}:5432/postgres?sslmode=disable
    depends_on: [db]
{{- end}}
    volumes:
{{- if .InModule}}
      - {{.Up}}:/app
{{- else}}
      - .:{{.DevWork}}
{{- end}}
{{- if .GantryMount}}
      - {{.GantryPath}}:{{.GantryMount}}
{{- end}}
      - data:/data
{{- if .Postgres}}

  db:
    image: {{.PostgresImage}}
    environment:
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: {{.Name}}
    volumes:
      - pgdata:/var/lib/postgresql/data
{{- end}}

volumes:
  data:
{{- if .Postgres}}
  pgdata:
{{- end}}

x-houston:
  health: /up
  commands:
    test: sh -c "go vet ./... && go test ./..."
    console: { dev: go run ./cmd/{{.Name}} db console, server: /app db console }
