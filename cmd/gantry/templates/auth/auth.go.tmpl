package auth

import (
 "net/http"
 "time"
 gantryauth "github.com/scttymn/gantry/auth"
 "github.com/scttymn/gantry/db"
 "github.com/scttymn/gantry/mail"
 "github.com/scttymn/gantry/sign"
 "github.com/scttymn/gantry/web"
)

type Auth = gantryauth.Auth
type User = gantryauth.User

func New(d *db.DB, signer sign.Signer, sender mail.Sender, from, codeFile string) *Auth {
 return &Auth{
  DB:d, Signer:signer, Mail:sender, From:from, Limits:&web.Limits{},
  Idle:30*24*time.Hour, Lifetime:90*24*time.Hour,
  FirstUser:&gantryauth.FirstUser{CodeFile:codeFile},
  Views:gantryauth.Views{
   Login:func(w http.ResponseWriter,r *http.Request,p gantryauth.Page) error { return web.Render(w,r,pageStatus(p),signIn(p)) },
   Setup:func(w http.ResponseWriter,r *http.Request,p gantryauth.Page) error { return web.Render(w,r,pageStatus(p),setup(p)) },
   ForgotPassword:func(w http.ResponseWriter,r *http.Request,p gantryauth.Page) error { return web.Render(w,r,pageStatus(p),forgotPassword(p)) },
   EditPassword:func(w http.ResponseWriter,r *http.Request,p gantryauth.Page,token string) error { return web.Render(w,r,pageStatus(p),editPassword(p,token)) },
  },
 }
}

func pageStatus(p gantryauth.Page) int { if p.Status != 0 { return p.Status }; return http.StatusOK }
func Current(r *http.Request) (User,bool) { return gantryauth.Current(r) }
