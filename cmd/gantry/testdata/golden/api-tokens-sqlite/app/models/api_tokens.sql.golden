-- API tokens (gantry g api-tokens; app/apitokens).

-- name: CreateAPIToken :one
INSERT INTO api_tokens (name, token_digest, created_at, updated_at)
VALUES (sqlc.arg(name), sqlc.arg(token_digest), sqlc.arg(now), sqlc.arg(now))
RETURNING *;

-- name: FindAPITokenByDigest :one
SELECT * FROM api_tokens WHERE token_digest = sqlc.arg(token_digest);

-- name: ListAPITokens :many
SELECT * FROM api_tokens ORDER BY name;

-- name: DeleteAPIToken :exec
DELETE FROM api_tokens WHERE id = sqlc.arg(id);

-- name: TouchAPIToken :exec
UPDATE api_tokens SET last_used_at = sqlc.arg(now) WHERE id = sqlc.arg(id);
