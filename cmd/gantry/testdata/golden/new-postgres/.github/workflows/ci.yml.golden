name: ci

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    env:
      GH_TOKEN: ${{ github.token }}
      POSTGRES_PASSWORD: ci-only
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - name: templ and sqlc, from the Dockerfile's toolchain
        run: |
          docker build -q --target toolchain -t shop-toolchain .
          mkdir -p "$RUNNER_TEMP/bin"
          id=$(docker create shop-toolchain)
          docker cp "$id:/go/bin/templ" "$RUNNER_TEMP/bin/templ"
          docker cp "$id:/usr/local/bin/sqlc" "$RUNNER_TEMP/bin/sqlc"
          docker rm "$id" >/dev/null
          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
      - run: bin/gantry check --strict
      - run: bin/gantry check --generated
      - run: bin/gantry test
      - run: bin/gantry verify
