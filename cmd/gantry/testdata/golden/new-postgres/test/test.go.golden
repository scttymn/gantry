// Package test is what the app's tests share: a database of their own,
// migrated. Fixtures go in test/fixtures/<table>.yml (testkit.Fixtures).
package test

import (
	"testing"

	"github.com/scttymn/gantry/db"
	"github.com/scttymn/gantry/testkit"

	"example.com/shop/db/migrations"
)

// DB is an empty, migrated database, removed after the test: a
// database of its own on the Postgres server at TEST_DATABASE_URL.
func DB(t testing.TB) *db.DB { return testkit.Postgres(t, migrations.Up) }
