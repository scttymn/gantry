package auth

import (
	"log/slog"
	"net/http"
	"path/filepath"
	"testing"

	"example.com/shop/test"
	"github.com/scttymn/gantry/sign"
	"github.com/scttymn/gantry/testkit"
	"github.com/scttymn/gantry/web"
)

func TestPasswordSetupAndLogin(t *testing.T) {
	a := New(test.DB(t), sign.Signer{Key: []byte("test cookies")}, nil, "", filepath.Join(t.TempDir(), "setup-code"))
	a.Paths.AfterLogin = "/account"
	rt := web.NewRouter(slog.New(slog.DiscardHandler), nil)
	a.Routes(rt)
	rt.Scope("/account", web.Pipeline{a.Required}, func(s *web.Scope) {
		s.Handle("GET /{$}", func(w http.ResponseWriter, r *http.Request) error { return SignOut().Render(r.Context(), w) })
	})
	b := testkit.Browser(t, rt.Handler())
	page := b.Get("/login")
	if page.Code != 200 || page.Text("h1") != "Create your first account" {
		t.Fatalf("setup form: %d %s", page.Code, page.Body)
	}
	code, err := a.FirstUserCode(t.Context(), false)
	if err != nil {
		t.Fatal(err)
	}
	form := map[string]string{"setup_code": code, "email_address": "owner@example.com", "password": "correct horse", "password_confirmation": "incorrect"}
	invalid := page.Submit("#first-user", form)
	if invalid.Code != 422 || invalid.Find(`input[name="setup_code"][value]`).Length() != 0 {
		t.Fatal("invalid setup did not safely rerender")
	}
	form["password_confirmation"] = "correct horse"
	created := b.Get("/login").Submit("#first-user", form)
	if created.Code != 303 || b.Get("/account/").Code != 200 {
		t.Fatal("setup didn't sign in")
	}
	if b.Get("/login").Text("h1") != "Sign in" {
		t.Fatal("setup stayed open")
	}
	b.Get("/account/").Submit("#sign-out", nil)
	signedIn := b.Get("/login").Submit("form", map[string]string{"email_address": "owner@example.com", "password": "correct horse"})
	if signedIn.Code != 302 || b.Get("/account/").Code != 200 {
		t.Fatal("password login failed")
	}
}
