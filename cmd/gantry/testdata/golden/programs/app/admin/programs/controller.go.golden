package programs

import (
	"maps"
	"net/http"
	"strconv"
	"strings"

	"github.com/a-h/templ"

	"github.com/scttymn/gantry/db"
	"github.com/scttymn/gantry/web"

	"example.com/gym/app/models"
	"example.com/gym/app/shared/resource"
)

const (
	path       = "/admin/programs"
	param      = "program"
	title      = "Programs"
	singular   = "Program"
	recordType = "Program"
)

type Controller struct{ resource.Controller }

var fields = []resource.Field{resource.F("name"), resource.F("blurb", resource.Type("textarea")), resource.F("photo", resource.Type("file")), resource.F("cta"), resource.Position}

var editFields = append(fields, resource.F("lock_version", resource.Type("hidden")))

func formValues(program models.Program) map[string]string {
	return map[string]string{"name": program.Name, "blurb": program.Blurb, "cta": program.CTA, "position": resource.IntText(program.Position), "lock_version": strconv.FormatInt(program.LockVersion, 10)}
}

func fromForm(v map[string]string) models.Program {
	return models.Program{Name: v["name"], Blurb: v["blurb"], CTA: v["cta"], Position: resource.OptionalInt(v["position"])}
}

func (c Controller) Index(w http.ResponseWriter, r *http.Request) error {
	list, err := models.New(c.DB.Read).ListPrograms(r.Context())
	if err != nil {
		return err
	}
	rows := make([]resource.Row, len(list))
	for i, program := range list {
		rows[i] = resource.Row{ID: program.ID, Cells: []string{resource.ListText(program.Name), resource.ListText(program.Blurb)}}
	}
	return c.Render(w, r, http.StatusOK, title, func(p resource.Page) templ.Component { return index(p, rows) })
}

func (c Controller) New(w http.ResponseWriter, r *http.Request) error {
	return c.form(w, r, http.StatusOK, 0, map[string]string{}, nil)
}

func (c Controller) Create(w http.ResponseWriter, r *http.Request) error {
	v := resource.Overlay(r, param, map[string]string{})
	program := fromForm(v)
	if errs := program.Errors(); len(errs) > 0 {
		return c.form(w, r, http.StatusUnprocessableEntity, 0, v, errs)
	}
	var id int64
	err := c.DB.Tx(r.Context(), func(tx *db.Tx) (err error) {
		q := models.New(tx)
		if !program.Position.Valid {
			next, err := q.NextProgramPosition(r.Context())
			if err != nil {
				return err
			}
			program.Position.Int64, program.Position.Valid = next, true
		}
		id, err = q.CreateProgram(r.Context(), models.CreateProgramParams{Name: program.Name, Blurb: program.Blurb, CTA: program.CTA, Position: program.Position, Now: c.Now()})
		return err
	})
	if err != nil {
		return err
	}
	if err := c.SavePhoto(r, param, "photo", recordType, id); err != nil {
		return err
	}
	return c.Created(w, r, path, singular)
}

func (c Controller) Edit(w http.ResponseWriter, r *http.Request) error {
	program, err := models.New(c.DB.Read).GetProgram(r.Context(), web.ID(r, "id"))
	if err != nil {
		return err
	}
	return c.form(w, r, http.StatusOK, program.ID, formValues(program), nil)
}

func (c Controller) Update(w http.ResponseWriter, r *http.Request) error {
	sent := resource.Overlay(r, param, map[string]string{})
	var (
		id     int64
		v      map[string]string
		status int
		errs   []string
	)
	err := c.DB.Tx(r.Context(), func(tx *db.Tx) error {
		q := models.New(tx)
		was, err := q.GetProgramForUpdate(r.Context(), web.ID(r, "id"))
		if err != nil {
			return err
		}
		id, v = was.ID, formValues(was)
		version := v["lock_version"]
		maps.Copy(v, sent)
		v["lock_version"] = version
		if sent["lock_version"] != version {
			status, errs = http.StatusConflict, []string{"Someone else changed this record while you were editing. Review the current values and submit again."}
			return nil
		}
		program := fromForm(v)
		if errs = program.Errors(); len(errs) > 0 {
			status = http.StatusUnprocessableEntity
			return nil
		}
		return q.UpdateProgram(r.Context(), models.UpdateProgramParams{Name: program.Name, Blurb: program.Blurb, CTA: program.CTA, Position: program.Position, Now: c.Now(), ID: id})
	})
	if err != nil {
		return err
	}
	if len(errs) > 0 {
		return c.form(w, r, status, id, v, errs)
	}
	if err := c.SavePhoto(r, param, "photo", recordType, id); err != nil {
		return err
	}
	return c.Saved(w, r, path, singular)
}

func (c Controller) Delete(w http.ResponseWriter, r *http.Request) error {
	q := models.New(c.DB.Write)
	program, err := q.GetProgram(r.Context(), web.ID(r, "id"))
	if err != nil {
		return err
	}
	if err := c.PurgePhoto(r.Context(), recordType, program.ID, "photo"); err != nil {
		return err
	}
	if err := q.DeleteProgram(r.Context(), program.ID); err != nil {
		return err
	}
	return c.Deleted(w, r, path, singular)
}

func (c Controller) form(w http.ResponseWriter, r *http.Request, status int, id int64, v map[string]string, errs []string) error {
	f := resource.Form{Param: param, Values: v, Errors: errs, Fields: fields, Cancel: path, Action: path, Method: "post"}
	heading := "New " + strings.ToLower(singular)
	if id != 0 {
		f.Action, f.Method, f.Fields, heading = path+"/"+web.IDText(id), "patch", editFields, "Edit "+strings.ToLower(singular)
		photos, err := c.PhotoPreviews(r.Context(), recordType, id, "photo")
		if err != nil {
			return err
		}
		f.Photos = photos
	}
	return c.Render(w, r, status, heading, func(p resource.Page) templ.Component { return form(p, f) })
}
