-- Sessions (gantry g auth; app/auth): found by their token's digest.

-- name: CreateSession :one
INSERT INTO sessions (user_id, token_digest, ip_address, user_agent, created_at, last_seen_at)
VALUES (sqlc.arg(user_id), sqlc.arg(token_digest), sqlc.arg(ip_address), sqlc.arg(user_agent), sqlc.arg(now), sqlc.arg(now))
RETURNING *;

-- name: FindSessionByDigest :one
SELECT sqlc.embed(sessions), sqlc.embed(users)
FROM sessions JOIN users ON users.id = sessions.user_id
WHERE sessions.token_digest = sqlc.arg(token_digest);

-- name: TouchSession :exec
UPDATE sessions SET last_seen_at = sqlc.arg(now) WHERE id = sqlc.arg(id);

-- name: DeleteSession :exec
DELETE FROM sessions WHERE id = sqlc.arg(id);

-- name: DeleteUserSessions :exec
DELETE FROM sessions WHERE user_id = sqlc.arg(user_id);
