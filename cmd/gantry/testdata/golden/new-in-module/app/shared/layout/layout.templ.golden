package layout

import (
	"github.com/scttymn/gantry/meta"

	"example.com/big/apps/control/assets"
)

type Page struct {
	Title       string
	Description string
	Path        string
	Image       string
}

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>{ p.Title }</title>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			@meta.Tags(Site, meta.Page{Title: p.Title, Description: p.Description, Path: p.Path, Image: p.Image})
			@assets.Styles.Tag()
			@assets.ImportMap.Tag()
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
