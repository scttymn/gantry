#!/usr/bin/env bash
# Runs shellcheck on every shell script git tracks, as the ci workflow's step runs
# it: each file whose first line runs sh, bash, dash or ksh, or that's named
# .sh or .bash, a generator's template (.tmpl) or golden (.golden) of one too.
# A script added anywhere is checked, with no list to add it to
# (TestEveryScriptIsShellchecked).
#
#   bin/shellcheck          check them
#   bin/shellcheck FILE...  check only the named tracked shell scripts
#   bin/shellcheck --list   name them, one a line
set -euo pipefail
cd "$(dirname "$0")/.."

list=
targets=()
if [ "${1:-}" = "--list" ]; then
	[ $# -eq 1 ] || { echo "usage: bin/shellcheck [--list | FILE...]" >&2; exit 2; }
	list=1
elif [ $# -gt 0 ]; then
	for arg in "$@"; do
		case "$arg" in
			-*) echo "usage: bin/shellcheck [--list | FILE...]" >&2; exit 2 ;;
		esac
		targets+=("$arg")
	done
fi

shell='^#!.*[/[:space:]](ba|da|k)?sh([[:space:]]|$)'
is_shell() {
	local file=$1 name first=
	[ -f "$file" ] || return 1
	name=${file%.golden}
	name=${name%.tmpl}
	IFS= read -r first <"$file" || true
	[[ $name == *.sh || $name == *.bash || $first =~ $shell ]]
}

scripts=()
if [ "${#targets[@]}" -gt 0 ]; then
	for file in "${targets[@]}"; do
		is_shell "$file" && scripts+=("$file")
	done
	[ "${#scripts[@]}" -gt 0 ] || exit 0
else
	while IFS= read -r -d '' file; do
		is_shell "$file" && scripts+=("$file")
	done < <(git ls-files -z)
	[ "${#scripts[@]}" -gt 0 ] || { echo "bin/shellcheck: git tracks no shell scripts here (git ls-files)" >&2; exit 1; }
fi

if [ -n "$list" ]; then
	printf '%s\n' "${scripts[@]}"
	exit
fi
timeout 300 docker run --rm -v "$PWD:/mnt" koalaman/shellcheck:v0.11.0@sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d "${scripts[@]}"
